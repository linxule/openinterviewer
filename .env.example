# OpenInterviewer environment template
#
# Copy this file to .env.local for local standalone development.
# Never commit real secrets. Hosted researchers enter their own AI and Upstash
# credentials in the application UI; the hosted operator section is platform-only.

# -----------------------------------------------------------------------------
# Standalone self-host (default)
# -----------------------------------------------------------------------------

DEPLOYMENT_MODE=standalone
APP_BASE_URL=http://localhost:3000

# Generate every value independently. Never reuse ADMIN_PASSWORD as a signing
# secret, and never reuse SESSION_SECRET, PARTICIPANT_TOKEN_SECRET, or
# RATE_LIMIT_SALT with one another.
ADMIN_PASSWORD=
SESSION_SECRET=
PARTICIPANT_TOKEN_SECRET=
RATE_LIMIT_SALT=

# Upstash Redis REST credentials. Storage is required for real studies and
# interviews; it is not auto-provisioned by this repository.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Configure at least one provider and set AI_PROVIDER to a configured provider.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional provider-specific defaults. A saved study may select another model
# that is available on the same provider account.
# GEMINI_MODEL=
# CLAUDE_MODEL=

# -----------------------------------------------------------------------------
# Hosted platform operator (use instead of the standalone section)
# -----------------------------------------------------------------------------

# DEPLOYMENT_MODE=hosted
# APP_BASE_URL=https://hosted.example.org
# SESSION_SECRET=
# PARTICIPANT_TOKEN_SECRET=
# RATE_LIMIT_SALT=

# Platform-owned Upstash database for accounts, encrypted BYOS credentials,
# ownership, and opaque participant-link records. Use a distinct prefix/database
# for every environment.
# PLATFORM_KV_REST_API_URL=
# PLATFORM_KV_REST_API_TOKEN=
# PLATFORM_KEY_PREFIX=staging

# Preferred versioned AES-256-GCM keyring. Each JSON value must be a base64-
# encoded 32-byte key; ACTIVE_KEY_ID must name one entry.
# CREDENTIAL_ENCRYPTION_KEYS={"2026-08":"BASE64_32_BYTE_KEY"}
# CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=2026-08

# Legacy migration only: retain while old unversioned encrypted credentials must
# still be read, then rotate those records and remove this variable.
# CREDENTIAL_ENCRYPTION_KEY=

# Configure at least one complete OAuth pair. Use different clients and callback
# URLs for staging and production.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Do not put credentials in NEXT_PUBLIC_* variables. Hosted researcher AI keys
# and personal Upstash credentials belong in the authenticated onboarding UI,
# not in this environment file.
