# OpenInterviewer environment template
#
# Copy this file to .env.local for local standalone development.
# Never commit real secrets. Hosted researchers enter their own AI and Upstash
# credentials in the application UI; the hosted operator section is platform-only.

# -----------------------------------------------------------------------------
# Standalone self-host (default)
# -----------------------------------------------------------------------------

DEPLOYMENT_MODE=standalone
APP_BASE_URL=http://localhost:3000

# ADMIN_PASSWORD must contain at least 16 characters. Generate every value
# independently. Never reuse ADMIN_PASSWORD as a signing secret, and never reuse
# SESSION_SECRET, PARTICIPANT_TOKEN_SECRET, or RATE_LIMIT_SALT with one another.
ADMIN_PASSWORD=
SESSION_SECRET=
PARTICIPANT_TOKEN_SECRET=
RATE_LIMIT_SALT=

# Upstash Redis REST credentials. Storage is required for real studies and
# interviews; it is not auto-provisioned by this repository.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# AI transport:
# - direct (default): use the matching provider key below.
# - gateway: use Vercel AI Gateway with Vercel OIDC in deployments, or set
#   AI_GATEWAY_API_KEY outside Vercel. Gateway supports Gemini, Claude, and
#   OpenAI studies; OpenRouter remains direct-only.
AI_TRANSPORT=direct
AI_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Vercel Gateway alternative (do not also expose provider keys unless another
# deployment still uses direct transport):
# AI_TRANSPORT=gateway
# AI_GATEWAY_API_KEY=  # Optional on Vercel because OIDC is automatic.
# AI_GATEWAY_ZERO_DATA_RETENTION=false

# Optional provider-specific interview-turn defaults. A saved study may select
# another interview model that is available on the same provider account.
# Synthesis operations use the provider-specific synthesis model in source and
# store that actual model in provenance.
# GEMINI_MODEL=
# CLAUDE_MODEL=
# OPENAI_MODEL=
# OPENROUTER_MODEL=
# AI_MODEL=  # Legacy migration fallback; provider-specific variables win.

# -----------------------------------------------------------------------------
# Hosted platform operator (use instead of the standalone section)
# -----------------------------------------------------------------------------

# DEPLOYMENT_MODE=hosted
# AI_TRANSPORT=direct
# APP_BASE_URL=https://hosted.example.org
# SESSION_SECRET=
# PARTICIPANT_TOKEN_SECRET=
# RATE_LIMIT_SALT=

# Platform-owned Upstash database for accounts, encrypted BYOS credentials,
# ownership, and opaque participant-link records. Use a distinct prefix/database
# for every environment.
# PLATFORM_KV_REST_API_URL=
# PLATFORM_KV_REST_API_TOKEN=
# PLATFORM_KEY_PREFIX=staging
# PLATFORM_SCHEMA_LINEAGE=
# ACCOUNT_DELETE_RECONCILE_TOKEN=

# Preferred versioned AES-256-GCM keyring. Each JSON value must be a base64-
# encoded 32-byte key; ACTIVE_KEY_ID must name one entry.
# CREDENTIAL_ENCRYPTION_KEYS={"2026-08":"BASE64_32_BYTE_KEY"}
# CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=2026-08

# Legacy migration only: retain while old unversioned encrypted credentials must
# still be read, then rotate those records and remove this variable.
# CREDENTIAL_ENCRYPTION_KEY=

# Configure at least one complete OAuth pair; either provider may be omitted when
# the other pair is complete. Use different clients and callback URLs for
# staging and production.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Do not put credentials in NEXT_PUBLIC_* variables. Hosted researcher Gemini,
# Anthropic, OpenAI, and OpenRouter keys and personal Upstash credentials belong
# in the authenticated onboarding UI, not in this environment file. Hosted mode
# ignores deployment-owner provider API keys for researcher work and never falls
# back to them.
