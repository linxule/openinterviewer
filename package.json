{
  "name": "openinterviewer",
  "version": "4.1.1",
  "description": "Open-source platform for adaptive, AI-assisted qualitative interviews.",
  "private": true,
  "license": "MIT",
  "homepage": "https://openinterviewer.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/linxule/openinterviewer.git"
  },
  "bugs": {
    "url": "https://github.com/linxule/openinterviewer/issues"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cloudflare/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:setup": "node --test tests/setup-checker.test.mjs",
    "test:e2e": "playwright test",
    "test:redis-crash": "vitest run --config vitest.integration.config.mts tests/integration/redis.crashCuts.test.ts",
    "test:adversarial": "vitest run --config vitest.integration.config.mts tests/unit/hosted.sharedByos.adversarial.test.ts tests/integration/hosted.sharedByos.realredis.test.ts",
    "setup:check": "node scripts/check-setup.mjs",
    "check": "node scripts/check-sync-artifacts.mjs && npm run lint && npm run typecheck && npm run test",
    "test:cloudflare": "vitest run --config vitest.workers.config.mts",
    "test:contract:redis": "vitest run --config vitest.integration.config.mts tests/integration/workspaceStore.redis.contract.test.ts tests/integration/signInBudget.redis.test.ts",
    "test:inventory:redis": "vitest run --config vitest.integration.config.mts tests/integration/inventoryRedis.test.ts",
    "typegen:cloudflare": "wrangler types --strict-vars=false cloudflare/worker-configuration.d.ts",
    "build:cloudflare": "node scripts/cloudflare/build.mjs",
    "test:cloudflare:artifact": "vitest run --config vitest.artifact.config.mts",
    "test:cloudflare:restart": "vitest run --config vitest.restart.config.mts",
    "setup:cloudflare": "node scripts/cloudflare/setup.mjs",
    "deploy:cloudflare": "node scripts/cloudflare/deploy.mjs",
    "preview:cloudflare": "node scripts/cloudflare/preview.mjs",
    "operator:cloudflare": "node scripts/cloudflare/operator.mjs",
    "inventory:redis": "node scripts/cloudflare/inventory-redis.mjs",
    "test:setup:cloudflare": "node --test tests/setup-cloudflare/*.test.mjs",
    "test:e2e:cloudflare": "playwright test --config playwright.cloudflare.config.ts",
    "check:cloudflare": "node scripts/cloudflare/check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@google/genai": "^2.24.0",
    "@openrouter/sdk": "1.3.17",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.109",
    "arctic": "^3.7.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "next": "^16.3.5",
    "openai": "^7.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.3",
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.1",
    "postcss": "^8",
    "redis": "^6.2.1",
    "tailwindcss": "^3.4.19",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.136.3"
  }
}
