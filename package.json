{
  "name": "openinterviewer",
  "version": "2.0.0",
  "description": "Open-source platform for adaptive, AI-assisted qualitative interviews.",
  "private": true,
  "license": "MIT",
  "homepage": "https://openinterviewer.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/linxule/openinterviewer.git"
  },
  "bugs": {
    "url": "https://github.com/linxule/openinterviewer/issues"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:setup": "node --test tests/setup-checker.test.mjs",
    "test:e2e": "playwright test",
    "test:redis-crash": "vitest run --config vitest.integration.config.mts tests/integration/redis.crashCuts.test.ts",
    "test:adversarial": "vitest run --config vitest.integration.config.mts tests/unit/hosted.sharedByos.adversarial.test.ts tests/integration/hosted.sharedByos.realredis.test.ts",
    "setup:check": "node scripts/check-setup.mjs",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@google/genai": "^2.17.1",
    "@openrouter/sdk": "1.2.35",
    "@upstash/redis": "^1.36.2",
    "ai": "^7.0.65",
    "arctic": "^3.7.0",
    "clsx": "^2.1.1",
    "jose": "^5.9.0",
    "jszip": "^3.10.1",
    "next": "^16.3.4",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.0",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "postcss": "^8",
    "redis": "^6.2.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
